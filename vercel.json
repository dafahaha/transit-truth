{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/docs/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/audit", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/github", "destination": "https://github.com/dafahaha/transit-truth", "permanent": false },
    { "source": "/repo", "destination": "https://github.com/dafahaha/transit-truth", "permanent": false },
    { "source": "/docs", "destination": "https://github.com/dafahaha/transit-truth#readme", "permanent": false }
  ]
}
